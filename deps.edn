{:mvn/repos {"sonatype" {:url "https://oss.sonatype.org/content/repositories/snapshots/"}}
 :paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.10.3"}}
 :aliases
 {;; for help: clojure -T:deps:build help/doc
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          :ns-default build}

  ;; versions to test against:
  :1.10 {:override-deps {org.clojure/clojure {:mvn/version "1.10.3"}}}
  :1.11 {:override-deps {org.clojure/clojure {:mvn/version "1.11.4"}}}
  :1.12 {:override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}}
  :1.13 {:override-deps {org.clojure/clojure {:mvn/version "1.13.0-alpha6"}}}

  ;; running tests/checks of various kinds:
  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :exec-fn     cognitect.test-runner.api/test}
  :runner
  {:main-opts   ["-m" "cognitect.test-runner"]}

  ;; various "runners" for tests/CI:
  :cljs {:extra-deps {olical/cljs-test-runner {:mvn/version "3.8.1"}}
         :main-opts ["-m" "cljs-test-runner.main"]}}}
